# Copy to .env for local runs. Never commit .env. Real secrets in App Store
# deployment are set via save_env_vars/apply_env_vars, never baked into the image.

# --- Server ---
PORT=8080
ALLOWED_ORIGIN=http://localhost:3000
# Shared team token gating the cost-incurring UDL routes. Leave unset locally to
# run with auth off (bound to loopback only); required before hosting for a team.
TEAM_TOKEN=[REDACTED:token]

# --- UDL upstream ---
UDL_BASE_URL=https://unifieddatalibrary.com
# Preferred in production / App Store: set these directly as env vars.
UDL_USERNAME=[REDACTED:username]
UDL_PASSWORD=[REDACTED:password]
# Local dev convenience only: if UDL_USERNAME/UDL_PASSWORD are unset, the app
# falls back to ~/.config/phase_offset/credentials.ini, section [udl] -
# matching the convention used by Ash's existing Script-mode tools. This file
# is never read inside the deployed container; the fallback is a local-only path.
UDL_TIMEOUT_SECONDS=15
# Default lookback window for the JCO HRR notification pull (INFERENCE, not
# a confirmed platform semantic - see src/udl_client.py docstring).
UDL_JCO_HRR_WINDOW_HOURS=24
